# ---------------------------------------------------------------------------
# 依赖与构建产物
# ---------------------------------------------------------------------------
node_modules/
out/
*.tsbuildinfo
*.vsix

# pdf.js 的打包产物：由 `npm run prepare:assets`（scripts/copy-pdfjs.mjs）
# 从 node_modules/pdfjs-dist 复制出来，属于构建产物，不入库。
media/vendor/

# ---------------------------------------------------------------------------
# 本地私有内容 —— 这些文件可能带账号、密码、会话 Cookie
# ---------------------------------------------------------------------------
# 抓包 / 调试日志（tools/dump_server.py 会写出这种文件）
*.log
dump_requests.log

# 环境变量与密钥
.env
.env.*
!.env.example
.npmrc
*.pem
*.key
*.p12
secrets.json

# ---------------------------------------------------------------------------
# 运行时产物：扩展把下载的题面默认存到 <工作区>/problems/
# ---------------------------------------------------------------------------
problems/

# ---------------------------------------------------------------------------
# 系统与编辑器
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json

# npm 缓存（本机 HOME 不可写，缓存被指到这里）
.npm-cache/
